# Salin menjadi .env lalu isi. Jangan commit .env (sudah di .gitignore).
DEBUG=true
JWT_SECRET=ganti-dengan-string-acak-64-karakter

# --- Asisten AI ------------------------------------------------------------
# auto = provider cloud pertama yang punya kunci (gemini → groq → mistral → openrouter), lalu ollama
AI_DEFAULT_PROVIDER=auto

# AI lokal — install https://ollama.com lalu: ollama pull llama3.2
# (CPU saja: llama3.2 ~8 token/dtk. Dengan GPU: qwen2.5:14b, bahasa Indonesia lebih baik.)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Google Gemini — kunci gratis: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Mistral — paket gratis "Experiment": https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Groq — tier gratis: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter — model berakhiran ":free": https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
